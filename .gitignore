# ─────────────────────────────────────────────────────────────
# 빌드 산출물
# ─────────────────────────────────────────────────────────────
build/
dist/
*.exe
*.spec.bak
__pycache__/
*.py[cod]
*.class

# 오프라인 설치용 휠 (용량이 커서 저장소에 두지 않는다)
whl/

# ─────────────────────────────────────────────────────────────
# 로컬 데이터 — 실 업무 데이터가 섞일 수 있으므로 커밋 금지
#
# metadata.db 와 attachments/ 는 샘플만 커밋한다.
# 앱을 실제로 쓰기 시작하면 두 항목이 실데이터로 덮이므로,
# 커밋 전 `git status` 로 반드시 확인할 것.
# 샘플 재생성: python sample_data/build_sample.py
# ─────────────────────────────────────────────────────────────
*.db
!metadata.db
*.db-wal
*.db-shm

# 앱이 만들지만 쓰이지 않는 잔여 파일
guide.db
contacts.db
tasks.db
tables.db

# ─────────────────────────────────────────────────────────────
# 작업 중 생성물
# ─────────────────────────────────────────────────────────────
scratch/
*.bak
*.log
error_out.txt
local_run.log
test_base64.html

# ─────────────────────────────────────────────────────────────
# 로컬 설정
# ─────────────────────────────────────────────────────────────
.claude/settings.local.json
.vscode/
.idea/
